<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Cyclomatic complexity for reports/ (reports/generate.sh): with CollectMetrics=true the CA1502 analyzer
       reports every method above the threshold in reports/CodeMetricsConfig.txt (1), i.e. all of them. -->
  <ItemGroup Condition="'$(CollectMetrics)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)reports/metrics.globalconfig" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)reports/CodeMetricsConfig.txt" />
  </ItemGroup>
</Project>
